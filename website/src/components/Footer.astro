---
import { SITE } from '../config';
---

<footer class="mt-auto border-t border-[var(--border-main)] bg-[var(--surface-elevated)] py-12">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2">
          <img src="/assets/logo/siply-logo.png" alt="Siply Logo" class="h-6 w-6 rounded-md opacity-80" />
          <span class="text-lg font-bold tracking-tight text-[var(--text-primary)]">Siply</span>
        </a>
        <p class="mt-4 text-sm text-[var(--text-secondary)]">
          A local-first hydration tracker built for mobile. Respects your privacy, works offline, and keeps your data on your device.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[var(--text-primary)]">Product</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/#features" class="text-sm text-[var(--text-secondary)] hover:text-[var(--color-siply-blue)] transition-colors">Features</a></li>
          <li><a href="/#privacy" class="text-sm text-[var(--text-secondary)] hover:text-[var(--color-siply-blue)] transition-colors">Privacy & AI</a></li>
          <li><a href="/#faq" class="text-sm text-[var(--text-secondary)] hover:text-[var(--color-siply-blue)] transition-colors">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[var(--text-primary)]">Download</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/download" class="text-sm text-[var(--text-secondary)] hover:text-[var(--color-siply-blue)] transition-colors">Android APK</a></li>
          <li><span class="text-sm text-[var(--text-muted)]">iOS (Coming Soon)</span></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[var(--text-primary)]">Source</h3>
        <ul class="mt-4 space-y-2">
          <li>
            <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--text-secondary)] hover:text-[var(--color-siply-blue)] transition-colors">
              GitHub Repository
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border-main)] pt-8 sm:flex-row">
      <p class="text-xs text-[var(--text-muted)]">
        &copy; {new Date().getFullYear()} Siply. Native mobile application.
      </p>
    </div>
  </div>
</footer>
