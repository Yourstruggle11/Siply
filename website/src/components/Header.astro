---
import { SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-[var(--border-main)] bg-[var(--bg-main)]/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2">
      <a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
        <img src="/assets/logo/siply-logo.png" alt="Siply Logo" class="h-8 w-8 rounded-lg" />
        <span class="text-xl font-bold tracking-tight text-[var(--text-primary)]">Siply</span>
      </a>
    </div>
    
    <nav class="flex items-center gap-4 sm:gap-6">
      <a href="/#features" class="text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)] hidden sm:block">Features</a>
      <a href="/#privacy" class="text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)] hidden sm:block">Privacy</a>
      <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]">
        GitHub
      </a>
      
      <div class="hidden sm:block h-4 w-px bg-[var(--border-main)]"></div>
      <ThemeToggle />
      
      <a href="/download" class="inline-flex h-9 items-center justify-center rounded-full bg-[var(--color-siply-blue)] px-4 py-2 text-sm font-medium text-white shadow transition-colors hover:bg-[var(--color-siply-blue-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-siply-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-main)]">
        Download
      </a>
    </nav>
  </div>
</header>
