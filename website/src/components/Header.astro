---
import { SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';
---

<header id="site-header" class="site-header sticky top-0 z-50 w-full border-b border-transparent">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2">
      <a href="/" class="flex items-center gap-2 transition-opacity hover:opacity-80">
        <img src="/assets/logo/siply-mark-96.png" width="32" height="32" alt="" class="h-8 w-8 rounded-lg" />
        <span class="text-xl font-bold tracking-tight text-[var(--text-primary)]">Siply</span>
      </a>
    </div>
    
    <nav aria-label="Main navigation" class="flex items-center gap-3 sm:gap-5">
      <a href="/#how-it-works" class="nav-link hidden md:block">How it works</a>
      <a href="/#features" class="nav-link hidden md:block">Features</a>
      <a href="/#privacy" class="text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)] hidden sm:block">Privacy</a>
      <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" class="nav-link hidden lg:block">
        GitHub
      </a>
      
      <div class="hidden sm:block h-4 w-px bg-[var(--border-main)]"></div>
      <div class="block">
        <ThemeToggle />
      </div>
      
      <a href="/download" class="button-primary compact-button">
        Get Siply
      </a>
    </nav>
  </div>
</header>
