---
interface Props {
  title: string;
  description: string;
  icon?: string;
}

const { title, description, icon } = Astro.props;
---

<div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm transition-all hover:shadow-md dark:border-zinc-800 dark:bg-[#1E1E1E]">
  {icon && (
    <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-2xl text-[#1279DF] dark:bg-blue-900/20">
      {icon}
    </div>
  )}
  <h3 class="mb-2 text-xl font-semibold text-zinc-900 dark:text-zinc-100">{title}</h3>
  <p class="text-zinc-600 leading-relaxed dark:text-zinc-400">{description}</p>
</div>
