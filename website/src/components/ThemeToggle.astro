<button
  id="theme-toggle"
  type="button"
  class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-secondary)] transition-colors hover:bg-[var(--surface-elevated)] hover:text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-siply-blue"
  aria-label="Switch theme"
  title="Switch theme"
>
  <span id="theme-icon-light" class="hidden" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
  </span>
  <span id="theme-icon-dark" class="hidden" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </span>
</button>

<script>
  class ThemeManager {
    themeToggle: HTMLElement | null;
    iconLight: HTMLElement | null;
    iconDark: HTMLElement | null;
    currentTheme: 'light' | 'dark';

    constructor() {
      this.themeToggle = document.getElementById('theme-toggle');
      this.iconLight = document.getElementById('theme-icon-light');
      this.iconDark = document.getElementById('theme-icon-dark');

      const storedTheme = localStorage.getItem('theme');
      this.currentTheme = storedTheme === 'light' || storedTheme === 'dark'
        ? storedTheme
        : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

      this.applyTheme(false);
      this.themeToggle?.addEventListener('click', () => {
        this.currentTheme = this.currentTheme === 'dark' ? 'light' : 'dark';
        this.applyTheme(true);
      });
    }

    applyTheme(save: boolean) {
      document.documentElement.classList.toggle('dark', this.currentTheme === 'dark');
      if (save) localStorage.setItem('theme', this.currentTheme);

      this.iconLight?.classList.toggle('hidden', this.currentTheme !== 'light');
      this.iconDark?.classList.toggle('hidden', this.currentTheme !== 'dark');

      const nextTheme = this.currentTheme === 'dark' ? 'light' : 'dark';
      const label = `Switch to ${nextTheme} theme`;
      this.themeToggle?.setAttribute('aria-label', label);
      this.themeToggle?.setAttribute('title', label);
    }
  }

  document.addEventListener('DOMContentLoaded', () => new ThemeManager());
</script>
