---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { RELEASES, SITE } from '../config';
---

<Layout
  title={`Download Siply ${RELEASES.latestAndroidVersion}`}
  description={`Download Siply ${RELEASES.latestAndroidVersion} for Android. Private hydration tracking with reminders that adjust around your progress.`}
>
  <Header />

  <main id="main-content" class="download-main flex-1">
    <div class="download-orb" aria-hidden="true"></div>
    <section class="mx-auto max-w-5xl px-4 pb-12 pt-16 text-center sm:px-6 md:pb-16 md:pt-24 lg:px-8">
      <p class="eyebrow justify-center" data-reveal>Available now for Android</p>
      <h1 class="mx-auto mt-5 max-w-4xl text-balance text-[clamp(3rem,8vw,5.7rem)] font-[850] leading-[.96] tracking-[-.06em]" data-reveal style="--reveal-delay:70ms">
        Take a better hydration rhythm with you.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-balance text-lg leading-8 text-[var(--text-secondary)]" data-reveal style="--reveal-delay:140ms">
        Download Siply directly to your Android device. It is free, open source, and ready without an account.
      </p>
    </section>

    <section class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8" data-reveal>
      <div class="download-card">
        <div class="download-product">
          <div class="download-mark">
            <img src="/assets/logo/siply-mark-192.png" width="74" height="74" alt="Siply app icon" />
          </div>
          <div>
            <span class="platform-label">Android APK</span>
            <h2>Siply {RELEASES.latestAndroidVersion}</h2>
            <p>Hosted on the public Siply GitHub release.</p>
          </div>
        </div>
        <a class="button-primary download-button" href={RELEASES.androidApkUrl}>
          Download APK
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 21h14" /></svg>
        </a>
      </div>

      <div class="download-trust" aria-label="Download trust details">
        <span><strong>Open source</strong> on GitHub</span>
        <span><strong>No account</strong> required</span>
        <span><strong>Offline core</strong> experience</span>
      </div>
    </section>

    <section class="mx-auto grid max-w-5xl gap-6 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-[1.12fr_.88fr] lg:px-8">
      <div class="install-card" data-reveal>
        <p class="eyebrow">Four quick steps</p>
        <h2>Install the APK</h2>
        <ol>
          <li><span>1</span><div><strong>Download</strong><p>Tap the button above and keep the APK when your browser asks.</p></div></li>
          <li><span>2</span><div><strong>Open the file</strong><p>Use the download notification or find it in your Downloads folder.</p></div></li>
          <li><span>3</span><div><strong>Allow this source</strong><p>If Android asks, allow your browser or file manager to install this app.</p></div></li>
          <li><span>4</span><div><strong>Install Siply</strong><p>Return to the installer, confirm, and open the app.</p></div></li>
        </ol>
      </div>

      <aside class="trust-card" data-reveal style="--reveal-delay:100ms">
        <div class="shield" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3 5 6v5c0 4.6 2.8 8.2 7 10 4.2-1.8 7-5.4 7-10V6zM9 12l2 2 4-5" /></svg>
        </div>
        <h2>Know what you install</h2>
        <p>The source code is public, and the APK is attached to Siply’s official GitHub release. Android’s “unknown apps” message means the app came from outside Google Play; it does not mean the file is automatically unsafe.</p>
        <a class="text-link" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">View the source on GitHub <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <section class="mx-auto max-w-4xl px-4 pb-20 sm:px-6 md:pb-28 lg:px-8" data-reveal>
      <div class="future-card">
        <div>
          <span class="platform-label">Looking for another platform?</span>
          <h2>iOS and store releases are planned.</h2>
          <p>For now, Siply is available as a direct Android download.</p>
        </div>
        <a href="/" class="button-secondary">Explore Siply</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .download-main { position:relative; overflow:hidden; }
  .download-orb { position:absolute; left:50%; top:-17rem; width:52rem; height:43rem; transform:translateX(-50%); border-radius:50%; background:radial-gradient(circle,rgba(49,190,220,.18),rgba(18,121,223,.08) 40%,transparent 70%); pointer-events:none; }
  .download-card { position:relative; display:flex; flex-direction:column; gap:1.5rem; padding:1.4rem; border:1px solid color-mix(in srgb,#1279df 34%,var(--border-main)); border-radius:2rem; background:color-mix(in srgb,var(--surface-main) 90%,transparent); box-shadow:var(--shadow-soft); backdrop-filter:blur(18px); }
  .download-product { display:flex; align-items:center; gap:1rem; }
  .download-mark { display:grid; flex:0 0 auto; place-items:center; width:5rem; height:5rem; overflow:hidden; border-radius:1.5rem; box-shadow:0 14px 30px rgba(18,121,223,.22); }
  .download-mark img { width:100%; height:100%; }
  .platform-label { color:#1279df; font-size:.72rem; font-weight:850; letter-spacing:.12em; text-transform:uppercase; }
  .download-product h2 { margin-top:.2rem; font-size:1.55rem; font-weight:850; letter-spacing:-.035em; }
  .download-product p { margin-top:.2rem; color:var(--text-muted); font-size:.78rem; }
  .download-button { width:100%; }
  .download-trust { display:grid; gap:.5rem; padding:1.25rem .5rem 0; color:var(--text-muted); font-size:.76rem; text-align:center; }
  .download-trust strong { color:var(--text-primary); }
  .install-card,.trust-card { border:1px solid var(--border-main); border-radius:1.8rem; background:var(--surface-main); padding:1.5rem; }
  .install-card h2,.trust-card h2 { margin-top:.65rem; font-size:clamp(1.8rem,4vw,2.5rem); font-weight:850; letter-spacing:-.045em; }
  .install-card ol { display:grid; gap:1.25rem; margin-top:2rem; }
  .install-card li { display:grid; grid-template-columns:2.5rem 1fr; gap:.9rem; }
  .install-card li>span { display:grid; place-items:center; width:2.5rem; height:2.5rem; border-radius:.85rem; background:color-mix(in srgb,#1279df 12%,transparent); color:#1279df; font-size:.82rem; font-weight:850; }
  .install-card strong { display:block; font-size:.95rem; }
  .install-card p { margin-top:.25rem; color:var(--text-secondary); font-size:.85rem; line-height:1.55; }
  .trust-card { display:flex; flex-direction:column; justify-content:center; background:linear-gradient(145deg,color-mix(in srgb,var(--surface-elevated) 75%,transparent),var(--surface-main)); }
  .shield { display:grid; place-items:center; width:4rem; height:4rem; border-radius:1.2rem; background:linear-gradient(145deg,#1279df,#42c6dd); color:white; box-shadow:0 14px 35px rgba(18,121,223,.26); animation:drop-bob 5s ease-in-out infinite; }
  .shield svg { width:2rem; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .trust-card p { margin-top:1rem; color:var(--text-secondary); font-size:.9rem; line-height:1.7; }
  .text-link { display:inline-flex; align-items:center; gap:.4rem; margin-top:1.4rem; color:#1279df; font-size:.9rem; font-weight:750; }
  .future-card { display:flex; flex-direction:column; gap:1.5rem; justify-content:space-between; padding:1.5rem; border:1px solid var(--border-main); border-radius:1.6rem; background:var(--surface-elevated); }
  .future-card h2 { margin-top:.4rem; font-size:1.4rem; font-weight:800; letter-spacing:-.03em; }
  .future-card p { margin-top:.35rem; color:var(--text-secondary); font-size:.85rem; }
  @media (min-width:640px) {
    .download-card { flex-direction:row; align-items:center; justify-content:space-between; padding:1.8rem; }
    .download-button { width:auto; }
    .download-trust { grid-template-columns:repeat(3,1fr); }
    .future-card { flex-direction:row; align-items:center; padding:1.8rem; }
  }
</style>
