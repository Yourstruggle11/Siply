---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { RELEASES } from '../config';
---

<Layout
  title={`Download Siply ${RELEASES.latestAndroidVersion}`}
  description={`Download Siply ${RELEASES.latestAndroidVersion} for Android. Local-first hydration tracking with reliable smart reminders.`}
>
  <Header />
  
  <main class="flex-1 bg-[var(--bg-main)] py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-bold tracking-tight text-[var(--text-primary)] sm:text-5xl">Get Siply</h1>
        <p class="mt-4 text-lg text-[var(--text-secondary)]">
          Start building your local-first hydration habit today.
        </p>
      </div>

      <div class="space-y-6">
        <!-- Android Section -->
        <div class="rounded-3xl border border-[var(--border-main)] bg-[var(--surface-elevated)] p-8 shadow-sm">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-main)] border border-[var(--border-main)]">
                <svg class="h-8 w-8 text-[var(--color-siply-blue)]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.4162.4162 0 00-.5676.1521l-2.0223 3.503C15.5902 8.244 13.8533 7.85 12 7.85c-1.8533 0-3.5902.394-5.1367 1.1004L4.841 5.4475a.4161.4161 0 00-.5676-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-[var(--text-primary)]">Android</h2>
                <p class="text-sm text-[var(--text-secondary)]">Latest version: <span class="font-medium text-[var(--text-primary)]">{RELEASES.latestAndroidVersion}</span></p>
              </div>
            </div>
            
            <div class="flex flex-col gap-3 w-full sm:w-auto">
              <a href={RELEASES.androidApkUrl} class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded-xl bg-[var(--color-siply-blue)] px-8 font-medium text-white transition-colors hover:bg-[var(--color-siply-blue-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-siply-blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-main)]">
                Download APK
              </a>
              <p class="text-xs text-center text-[var(--text-muted)] sm:max-w-[160px]">Direct download for Android devices</p>
            </div>
          </div>
        </div>

        <!-- iOS Section -->
        <div class="rounded-3xl border border-[var(--border-main)] bg-[var(--surface-elevated)] p-8 shadow-sm opacity-60">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--surface-main)] border border-[var(--border-main)]">
                <svg class="h-8 w-8 text-[var(--text-muted)]" fill="currentColor" viewBox="0 0 24 24"><path d="M12.44 2.89c.89-1.07 2.27-1.8 3.52-1.87.16 1.35-.45 2.76-1.32 3.8-.84 1.01-2.28 1.76-3.56 1.7-.2-1.42.48-2.61 1.36-3.63zm3.74 5.25c-1.74-.06-3.32 1.03-4.22 1.03-.92 0-2.22-.96-3.63-.94-1.87.03-3.6 1.09-4.57 2.77-1.95 3.39-.5 8.42 1.41 11.18.92 1.34 2 2.84 3.47 2.79 1.41-.05 1.95-.91 3.65-.91 1.69 0 2.18.91 3.67.88 1.54-.03 2.47-1.37 3.39-2.71 1.07-1.56 1.51-3.07 1.54-3.15-.03-.01-2.95-1.13-3.01-4.49-.05-2.8 2.29-4.14 2.4-4.2-1.31-1.92-3.35-2.18-4.1-2.25z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-[var(--text-primary)]">iOS</h2>
                <p class="text-sm text-[var(--text-secondary)]">iPhone and iPad</p>
              </div>
            </div>
            
            <div class="flex flex-col gap-3 w-full sm:w-auto">
              <button disabled class="inline-flex h-12 w-full sm:w-auto items-center justify-center rounded-xl bg-[var(--surface-main)] border border-[var(--border-main)] px-8 font-medium text-[var(--text-muted)] cursor-not-allowed">
                Coming soon
              </button>
            </div>
          </div>
        </div>

      </div>
      
      <div class="mt-12 rounded-2xl border border-[var(--color-siply-blue)]/20 bg-[var(--color-siply-blue)]/5 p-6">
        <h3 class="font-semibold text-[var(--text-primary)]">How to install an APK</h3>
        <ol class="mt-4 space-y-2 text-sm text-[var(--text-secondary)] list-decimal list-inside">
          <li>Download the APK file to your Android device.</li>
          <li>Open the downloaded file.</li>
          <li>If prompted, allow your browser or file manager to "Install unknown apps".</li>
          <li>Follow the on-screen instructions to complete the installation.</li>
        </ol>
      </div>

    </div>
  </main>
  
  <Footer />
</Layout>
