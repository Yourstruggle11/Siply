---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

const facts = [
  ['No account', 'Start tracking without creating a profile.'],
  ['Works offline', 'Logging, reminders, and history stay available.'],
  ['Open source', 'See exactly how Siply handles your data.'],
  ['Free on Android', 'Download the APK and make it yours.'],
];

const steps = [
  {
    number: '01',
    title: 'Set your day',
    copy: 'Choose a daily target and the hours when reminders should be active.',
  },
  {
    number: '02',
    title: 'Log in seconds',
    copy: 'Use a preset, enter a custom amount, or log straight from a notification.',
  },
  {
    number: '03',
    title: 'Keep moving',
    copy: 'Siply adjusts the remaining plan after every drink and keeps the next step clear.',
  },
];

const extras = [
  {
    icon: 'bell',
    title: 'Act from the reminder',
    copy: 'Log a drink without opening the app, with optional follow-up nudges kept under control.',
  },
  {
    icon: 'widget',
    title: 'Progress at a glance',
    copy: 'Android home-screen widgets show today’s progress and the next planned reminder.',
  },
  {
    icon: 'backup',
    title: 'Your history, portable',
    copy: 'Export a JSON backup when you want it and restore it on your terms.',
  },
  {
    icon: 'spark',
    title: 'AI is optional',
    copy: 'Bring your own provider key for Ask Siply and extra insights. Core features never depend on it.',
  },
  {
    icon: 'tune',
    title: 'Made for your routine',
    copy: 'Personalize units, drink presets, reminder tone, timing options, and appearance.',
  },
  {
    icon: 'share',
    title: 'Progress worth sharing',
    copy: 'Turn a good week into a simple visual you can save or share when you choose.',
  },
];

const iconPaths: Record<string, string> = {
  bell: 'M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4',
  widget: 'M4 4h6v6H4zM14 4h6v10h-6zM4 14h6v6H4zM14 18h6v2h-6z',
  backup: 'M12 3v12m0-12 4 4m-4-4L8 7M5 13v7h14v-7',
  spark: 'M12 3l1.35 4.65L18 9l-4.65 1.35L12 15l-1.35-4.65L6 9l4.65-1.35zM19 16l.65 2.35L22 19l-2.35.65L19 22l-.65-2.35L16 19l2.35-.65z',
  tune: 'M4 7h10M18 7h2M14 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0M4 17h2m4 0h10M6 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0',
  share: 'M8 12l8-5m-8 5 8 5M6 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4m12-5a2 2 0 1 0 0-4 2 2 0 0 0 0 4m0 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4',
};
---

<Layout preloadImage="/assets/screenshots/01-siply.jpg">
  <Header />

  <main id="main-content" class="flex-1">
    <section class="hero-section">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-[1.03fr_.97fr] lg:gap-16 lg:px-8 lg:py-28">
        <div class="relative z-10 max-w-2xl hero-copy">
          <p class="eyebrow">Free on Android <span aria-hidden="true">·</span> No account</p>
          <h1 class="mt-5 text-balance text-[clamp(3rem,6.5vw,5.85rem)] font-[850] leading-[.93] tracking-[-.06em] text-[var(--text-primary)]">
            Hydration reminders that <span class="text-gradient">keep up.</span>
          </h1>
          <p class="mt-7 max-w-xl text-balance text-lg leading-8 text-[var(--text-secondary)] sm:text-xl">
            Set your target and active hours. Siply plans the reminders, adjusts after every drink, and keeps your hydration data on your device.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a class="button-primary" href="/download">
              Get Siply for Android
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
            </a>
            <a class="button-secondary" href="#how-it-works">See how it works</a>
          </div>
          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-[var(--text-secondary)]" aria-label="Siply benefits">
            <li class="trust-item"><span aria-hidden="true">✓</span> Works offline</li>
            <li class="trust-item"><span aria-hidden="true">✓</span> Open source</li>
            <li class="trust-item"><span aria-hidden="true">✓</span> Private by default</li>
          </ul>
        </div>

        <div class="motion-stage" data-motion-stage aria-label="Siply adjusting the next reminder after a drink is logged">
          <div class="stage-glow" aria-hidden="true"></div>
          <div class="poster-card hero-poster">
            <img src="/assets/screenshots/01-siply.jpg" width="720" height="1564" alt="Siply Today screen showing a completed daily hydration goal" fetchpriority="high" decoding="async" />
          </div>

          <div class="plan-card" aria-hidden="true">
            <div class="plan-card-top">
              <span class="plan-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0" /></svg>
              </span>
              <span>Next reminder</span>
            </div>
            <div class="plan-time-wrap">
              <strong class="plan-time time-before">4:45 PM</strong>
              <strong class="plan-time time-after">5:15 PM</strong>
            </div>
            <span class="plan-status">Plan updated</span>
          </div>

          <div class="log-chip" aria-hidden="true">
            <span>+</span> 250 ml logged
          </div>
          <div class="local-chip" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M7 11V8a5 5 0 0 1 10 0v3m-11 0h12v10H6z" /></svg>
            Stored on device
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-[var(--border-main)] bg-[var(--surface-main)]/60" aria-label="Siply at a glance">
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-4 sm:px-6 lg:grid-cols-4 lg:px-8">
        {facts.map(([title, copy], index) => (
          <div class="fact-item" data-reveal style={`--reveal-delay:${index * 70}ms`}>
            <strong>{title}</strong>
            <span>{copy}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="how-it-works" class="section-shell">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <p class="eyebrow justify-center">How it works</p>
          <h2 class="section-heading mx-auto mt-4">Set it once. Siply handles the rhythm.</h2>
          <p class="section-copy mx-auto mt-5">A clear plan that responds when your day changes, without turning hydration into another task to manage.</p>
        </div>
        <div class="step-grid mt-14">
          {steps.map((step, index) => (
            <article class="step-card" data-reveal style={`--reveal-delay:${index * 110}ms`}>
              <div class="step-heading-row">
                <span class="step-number">{step.number}</span>
                <span class="step-state">{index === 0 ? 'Plan' : index === 1 ? 'Log' : 'Adjust'}</span>
              </div>

              <div class:list={['step-scene', `step-scene-${index + 1}`]} aria-hidden="true">
                {index === 0 && (
                  <>
                    <div class="active-window">
                      <span class="scene-label">Active hours</span>
                      <div><strong>7 AM</strong><i>→</i><strong>10 PM</strong></div>
                    </div>
                    <div class="target-chip">
                      <span class="target-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M22 12h-3"/></svg>
                      </span>
                      <span><small>Daily target</small><strong>2,000 ml</strong></span>
                    </div>
                  </>
                )}

                {index === 1 && (
                  <>
                    <div class="scene-cup">
                      <svg viewBox="0 0 48 60" fill="none"><path d="M8 9h32l-4 43H12L8 9Z"/><path class="scene-water" d="M11 28c8-5 17 5 26 0l-2 21H13l-2-21Z"/></svg>
                    </div>
                    <div class="scene-log-chip"><strong>+250 ml</strong><span>Added now</span></div>
                    <span class="scene-ripple"></span>
                  </>
                )}

                {index === 2 && (
                  <>
                    <div class="scene-reminder">
                      <span class="scene-clock">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0"/></svg>
                      </span>
                      <span class="scene-reminder-copy">
                        <small>Next reminder</small>
                        <span class="scene-time-wrap">
                          <strong class="scene-time scene-time-before">4:45 PM</strong>
                          <strong class="scene-time scene-time-after">5:15 PM</strong>
                        </span>
                      </span>
                    </div>
                    <div class="scene-updated"><span></span> Adjusted after your drink</div>
                  </>
                )}
              </div>

              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="features" class="section-shell feature-shell">
      <div class="mx-auto max-w-7xl space-y-24 px-4 sm:px-6 lg:space-y-32 lg:px-8">
        <article class="feature-row">
          <div class="feature-copy" data-reveal>
            <p class="eyebrow">Reliable reminders</p>
            <h2 class="section-heading mt-4">A plan that adapts after every drink.</h2>
            <p class="section-copy mt-5">Siply recalculates from what you have actually logged, keeps a quiet period after each drink, and makes the next reminder easy to understand.</p>
            <ul class="benefit-list">
              <li><span>01</span><div><strong>Stable between logs</strong><p>Your schedule does not drift just because you reopen the app.</p></div></li>
              <li><span>02</span><div><strong>Gentle when needed</strong><p>Optional nudges are spread across the day and respect your settings.</p></div></li>
              <li><span>03</span><div><strong>Clear next step</strong><p>See your next sip and reminder time without decoding a schedule.</p></div></li>
            </ul>
          </div>
          <div class="feature-visual reminder-visual" data-reveal style="--reveal-delay:120ms">
            <div class="poster-card feature-poster poster-reminders">
              <img src="/assets/screenshots/02-siply.jpg" width="720" height="1564" loading="lazy" alt="Siply showing today’s drink log and the next reminder" />
            </div>
            <div class="orbit-ring" aria-hidden="true"></div>
            <div class="mini-note mini-note-one" aria-hidden="true"><span></span> Quiet period active</div>
            <div class="mini-note mini-note-two" aria-hidden="true"><span></span> Next sip planned</div>
          </div>
        </article>

        <article class="feature-row feature-row-reverse">
          <div class="feature-copy" data-reveal>
            <p class="eyebrow">History that helps</p>
            <h2 class="section-heading mt-4">See the pattern, not just the number.</h2>
            <p class="section-copy mt-5">Follow your daily progress, streaks, goal consistency, and best hydration hours. Tap into a day when you want the details.</p>
            <div class="metric-strip" aria-label="History highlights">
              <div><strong>120</strong><span>days retained</span></div>
              <div><strong>28</strong><span>day consistency view</span></div>
              <div><strong>1</strong><span>clear daily story</span></div>
            </div>
          </div>
          <div class="feature-visual history-visual" data-reveal style="--reveal-delay:120ms">
            <div class="poster-card feature-poster poster-history">
              <img src="/assets/screenshots/05-siply.jpg" width="720" height="1564" loading="lazy" alt="Siply History screen with hydration trend and consistency views" />
            </div>
            <div class="trend-line" aria-hidden="true">
              <svg viewBox="0 0 220 80" fill="none"><path d="M3 65c25-5 25-28 49-27 20 1 24 21 45 13 23-9 27-39 53-34 18 4 29 25 67 7" /><circle cx="150" cy="17" r="5" /></svg>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section-shell overflow-hidden">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow">More of what helps</p>
          <h2 class="section-heading mt-4">Useful depth, without the clutter.</h2>
          <p class="section-copy mt-5">Siply stays focused on the habit, while giving you control when you want it.</p>
        </div>
        <div class="bento-grid mt-14">
          {extras.map((item, index) => (
            <article class:list={['bento-card', index === 0 || index === 3 ? 'bento-wide' : '']} data-reveal style={`--reveal-delay:${(index % 3) * 80}ms`}>
              <span class="bento-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d={iconPaths[item.icon]} /></svg>
              </span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="privacy" class="section-shell privacy-shell">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:px-8">
        <div data-reveal>
          <p class="eyebrow">Private by design</p>
          <h2 class="section-heading mt-4">Your hydration data stays yours.</h2>
          <p class="section-copy mt-5">Siply’s core experience runs locally. There is no Siply account, backend, advertising profile, or analytics SDK watching the habit you are building.</p>
          <a class="text-link mt-7" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">Inspect the source <span aria-hidden="true">↗</span></a>
        </div>
        <div class="privacy-panel" data-reveal style="--reveal-delay:100ms">
          <div class="privacy-lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M7 11V8a5 5 0 0 1 10 0v3m-11 0h12v10H6z" /></svg>
          </div>
          <div class="privacy-grid">
            <div><strong>No account</strong><span>Open the app and begin.</span></div>
            <div><strong>On-device history</strong><span>Your core data stays local.</span></div>
            <div><strong>Zero app analytics</strong><span>No behavior tracking SDKs.</span></div>
            <div><strong>AI only if invited</strong><span>You choose a provider and key.</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="section-shell">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[.72fr_1.28fr] lg:px-8">
        <div data-reveal>
          <p class="eyebrow">Good to know</p>
          <h2 class="section-heading mt-4">A few honest answers.</h2>
          <p class="section-copy mt-5">Everything you need to know before trying Siply.</p>
        </div>
        <div class="faq-list" data-reveal style="--reveal-delay:100ms">
          <details open>
            <summary>Is Siply free to use?<span aria-hidden="true"></span></summary>
            <p>Yes. The core app is free. Optional AI features use an API key from a supported provider and any provider charges are yours.</p>
          </details>
          <details>
            <summary>Does Siply work offline?<span aria-hidden="true"></span></summary>
            <p>Yes. Logging, history, reminders, and local insights work without internet. Network access is used only for optional AI features and app updates.</p>
          </details>
          <details>
            <summary>Where is my hydration data stored?<span aria-hidden="true"></span></summary>
            <p>On your device. Siply has no account system or backend. You can export a backup whenever you choose.</p>
          </details>
          <details>
            <summary>Why is the Android app an APK?<span aria-hidden="true"></span></summary>
            <p>Siply is currently distributed directly through its public GitHub release. The download page walks you through the one-time installation steps.</p>
          </details>
          <details>
            <summary>Is Siply on iOS or Google Play?<span aria-hidden="true"></span></summary>
            <p>Not yet. The current release is available as a direct Android download, with store distribution planned for the future.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="px-4 pb-20 sm:px-6 md:pb-28 lg:px-8">
      <div class="final-cta mx-auto max-w-7xl" data-reveal>
        <div class="cta-drop" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none"><path d="M24 5S10 21.2 10 31a14 14 0 0 0 28 0C38 21.2 24 5 24 5Z" /></svg>
        </div>
        <p class="eyebrow justify-center">A better rhythm starts here</p>
        <h2>Drink water. Keep your day.</h2>
        <p>Try Siply on Android. No account, no setup maze, no cloud required.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a class="button-primary" href="/download">Get Siply for Android</a>
          <a class="button-secondary" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero-section { position: relative; overflow: hidden; }
  .hero-copy { animation: hero-enter 850ms cubic-bezier(.22,1,.36,1) both; }
  .text-gradient { color: #1279df; background: linear-gradient(115deg,#0f77dc 15%,#45c7df 70%,#238df0); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-orb { position: absolute; border-radius: 999px; filter: blur(2px); pointer-events: none; }
  .hero-orb-one { width: 22rem; height: 22rem; left: -12rem; top: 4rem; background: radial-gradient(circle,rgba(45,194,218,.2),transparent 68%); }
  .hero-orb-two { width: 32rem; height: 32rem; right: -15rem; bottom: -8rem; background: radial-gradient(circle,rgba(18,121,223,.23),transparent 67%); }
  .trust-item { display:flex; align-items:center; gap:.45rem; }
  .trust-item span { display:grid; place-items:center; width:1.25rem; height:1.25rem; border-radius:999px; background:color-mix(in srgb,#1279df 13%,transparent); color:#1279df; font-size:.72rem; }
  .motion-stage { position:relative; width:min(100%,35rem); min-height:39rem; margin-inline:auto; perspective:1200px; transform-style:preserve-3d; }
  .stage-glow { position:absolute; inset:12% 3% 5%; border-radius:50%; background:radial-gradient(circle,rgba(54,177,234,.26),rgba(18,121,223,.08) 48%,transparent 70%); filter:blur(22px); }
  .hero-poster { --card-rotation: 3deg; position:absolute; top:0; left:50%; width:min(68%,20rem); transform:translateX(-50%) rotate(3deg) rotateX(var(--tilt-x,0deg)) rotateY(var(--tilt-y,0deg)); transform-origin:center; animation:poster-float 7s 250ms ease-in-out infinite; transition:transform 200ms ease-out; }
  .hero-poster img { aspect-ratio:720/1564; object-fit:cover; }
  .plan-card { position:absolute; z-index:3; right:0; top:26%; width:12.5rem; border:1px solid color-mix(in srgb,var(--border-main) 75%,white); border-radius:1.35rem; background:color-mix(in srgb,var(--surface-main) 90%,transparent); padding:1rem; box-shadow:0 16px 42px rgba(4,27,44,.2); backdrop-filter:blur(18px); animation:plan-pulse 6s 1.4s ease-in-out infinite; }
  .plan-card-top { display:flex; align-items:center; gap:.55rem; color:var(--text-secondary); font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; }
  .plan-icon { display:grid; place-items:center; width:1.75rem; height:1.75rem; border-radius:.6rem; background:color-mix(in srgb,#1279df 12%,transparent); color:#1279df; }
  .plan-icon svg { width:1rem; stroke-width:1.9; }
  .plan-time-wrap { position:relative; height:2.5rem; margin-top:.6rem; overflow:hidden; }
  .plan-time { position:absolute; inset:0; font-size:1.75rem; letter-spacing:-.04em; }
  .time-before { animation:time-before 6s 1.4s ease-in-out infinite; }
  .time-after { color:#1279df; animation:time-after 6s 1.4s ease-in-out infinite; }
  .plan-status { display:inline-flex; margin-top:.15rem; color:#16866a; font-size:.72rem; font-weight:700; }
  .log-chip,.local-chip { position:absolute; z-index:4; display:flex; align-items:center; gap:.5rem; border:1px solid var(--border-main); border-radius:999px; background:var(--surface-main); box-shadow:0 16px 40px rgba(5,33,52,.16); color:var(--text-primary); font-size:.82rem; font-weight:750; }
  .log-chip { left:-1%; top:55%; padding:.7rem 1rem; animation:log-arrives 6s 1.4s ease-in-out infinite; }
  .log-chip span { display:grid; place-items:center; width:1.4rem; height:1.4rem; border-radius:50%; background:#1279df; color:white; }
  .local-chip { right:5%; bottom:5%; padding:.72rem 1rem; animation:drift-card 6.5s ease-in-out infinite; }
  .local-chip svg { width:1rem; color:#1279df; stroke-width:1.9; }
  @keyframes poster-float { 0%,100% { transform:translateX(-50%) translateY(0) rotate(3deg) rotateX(var(--tilt-x,0deg)) rotateY(var(--tilt-y,0deg)); } 50% { transform:translateX(-50%) translateY(-10px) rotate(2deg) rotateX(var(--tilt-x,0deg)) rotateY(var(--tilt-y,0deg)); } }

  .fact-item { display:flex; min-height:8.5rem; flex-direction:column; justify-content:center; padding:1.5rem 1rem; border-right:1px solid var(--border-main); }
  .fact-item:nth-child(2n) { border-right:0; }
  .fact-item strong { font-size:1rem; }
  .fact-item span { margin-top:.35rem; color:var(--text-muted); font-size:.8rem; line-height:1.5; }
  .section-shell { padding:6rem 0; }
  .feature-shell { overflow:hidden; border-block:1px solid var(--border-main); background:color-mix(in srgb,var(--surface-elevated) 68%,transparent); }
  .step-grid { position:relative; display:grid; gap:1rem; }
  .step-card { position:relative; overflow:hidden; min-height:25rem; padding:1.4rem; border:1px solid var(--border-main); border-radius:1.75rem; background:linear-gradient(155deg,color-mix(in srgb,var(--surface-main) 96%,#1279df),var(--surface-main)); box-shadow:0 16px 46px rgba(15,52,78,.06); transition:transform .4s cubic-bezier(.22,1,.36,1),border-color .4s ease,box-shadow .4s ease; }
  .step-card::after { position:absolute; width:12rem; height:12rem; right:-6rem; bottom:-7rem; border-radius:50%; background:radial-gradient(circle,rgba(54,190,220,.13),transparent 70%); content:''; pointer-events:none; }
  .step-card:hover { transform:translateY(-7px); border-color:color-mix(in srgb,#1279df 40%,var(--border-main)); box-shadow:0 25px 65px rgba(9,54,86,.13); }
  .step-heading-row { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; }
  .step-number { color:#1279df; font-size:.76rem; font-weight:850; letter-spacing:.14em; }
  .step-state { padding:.32rem .55rem; border:1px solid var(--border-main); border-radius:999px; color:var(--text-muted); font-size:.62rem; font-weight:750; letter-spacing:.09em; text-transform:uppercase; }
