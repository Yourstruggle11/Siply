{
  "expo": {
    "name": "Siply",
    "slug": "siply",
    "scheme": "siply",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5e964072-425f-45f3-9978-ea2cf7eb3f3a"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1117"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "3",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Siply Backup",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.yourstruggle11.siply.backup"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.yourstruggle11.siply.backup",
            "UTTypeDescription": "Siply Backup File",
            "UTTypeConformsTo": [
              "public.json"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "siply.json"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C1117"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yourstruggle11.siply",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/json",
              "pathPattern": ".*\\.siply\\.json"
            },
            {
              "scheme": "content",
              "mimeType": "application/json",
              "pathPattern": ".*\\.siply\\.json"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/siply_reminder.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SiplyWidget",
              "label": "Siply Circular Widget",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Siply Circular Hydration Widget",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SiplyLinearWidget",
              "label": "Siply Linear Widget",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Siply Linear Hydration Widget",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Classic",
            "ios": "./assets/app-icons/classic.png",
            "android": {
              "foregroundImage": "./assets/app-icons/classic-foreground.png",
              "backgroundColor": "#F5F6F7"
            }
          },
          {
            "name": "Glossy",
            "ios": "./assets/app-icons/glossy.png",
            "android": {
              "foregroundImage": "./assets/app-icons/glossy-foreground.png",
              "backgroundColor": "#0C1117"
            }
          }
        ]
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e964072-425f-45f3-9978-ea2cf7eb3f3a"
      }
    }
  }
}
